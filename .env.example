# URL de la API de Laravel. Desde el celular NO sirve "localhost":
# usa la IP de tu PC en la red Wi-Fi (ipconfig) y arranca Laravel con
#   php artisan serve --host=0.0.0.0 --port=8001
# Sirve igual para el emulador de Android (con Expo Go, 10.0.2.2 da "Network Error").
EXPO_PUBLIC_API_URL=http://192.168.X.X:8001/api

# "Continuar con Google": ID de cliente OAuth de tipo "Web" (Google Cloud → Credenciales).
# Sin él, el botón no aparece. Solo funciona en un APK de EAS (no en Expo Go).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
