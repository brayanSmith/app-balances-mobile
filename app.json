{
  "expo": {
    "name": "Balances",
    "slug": "balances",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.brayansmith.balances"
    },
    "android": {
      "package": "com.brayansmith.balances",
      "adaptiveIcon": {
        "backgroundColor": "#D1FAE5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "lang": "es"
    },
    "plugins": [
      "expo-secure-store",
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Balances usa la cámara para fotografiar facturas y comprobantes.",
          "photosPermission": "Balances accede a tus fotos para adjuntar comprobantes.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#059669"
        }
      ],
      "expo-web-browser"
    ],
    "scheme": "balances",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "0c14aa9c-f953-4244-bf5b-0fe1d8688a87"
      }
    },
    "owner": "brayansmith"
  }
}
